      "seed": 1032,
      "version": 1,
      "versionNonce": 1033,
      "text": "Fires: prospect registration (non-blocking)\nTool: DuckDuckGo Search (ddgs)\nLLM: synthesizes structured company profile\nWrites: prospects.research_cache\nFreshness (hash + 3-day TTL) is decided by the\ncaller \u2014 this agent always runs fresh when invoked",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b1028",
      "originalText": "Fires: prospect registration (non-blocking)\nTool: DuckDuckGo Search (ddgs)\nLLM: synthesizes structured company profile\nWrites: prospects.research_cache\nFreshness (hash + 3-day TTL) is decided by the\ncaller \u2014 this agent always runs fresh when invoked",
      "lineHeight": 1.25
    },
