      "seed": 1044,
      "version": 1,
      "versionNonce": 1045,
      "text": "Fires: background, at /select-pillar\nInputs: research_cache + prospect context\n+ candidate question pool (context_tags)\nOutput: pillar.question_count question IDs\nFallback: rule-based selection by display_order\nif the LLM call fails, times out,\nor returns invalid IDs",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b1040",
      "originalText": "Fires: background, at /select-pillar\nInputs: research_cache + prospect context\n+ candidate question pool (context_tags)\nOutput: pillar.question_count question IDs\nFallback: rule-based selection by display_order\nif the LLM call fails, times out,\nor returns invalid IDs",
      "lineHeight": 1.25
    },
