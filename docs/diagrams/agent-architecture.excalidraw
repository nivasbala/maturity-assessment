      "version": 1,
      "versionNonce": 1102,
      "text": "Called by: generate_report_node\nInputs: pillar score + answers + research context\nOutput: executive_summary, strengths (2-4),\ngap_analysis (3-6), next_steps (4-6)\nRetries once on cardinality/vendor-name violation;\ntruncates over-max lists as a final safety net",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b1097",
      "originalText": "Called by: generate_report_node\nInputs: pillar score + answers + research context\nOutput: executive_summary, strengths (2-4),\ngap_analysis (3-6), next_steps (4-6)\nRetries once on cardinality/vendor-name violation;\ntruncates over-max lists as a final safety net",
      "lineHeight": 1.25
    },
